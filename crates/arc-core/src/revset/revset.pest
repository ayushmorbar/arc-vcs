WHITESPACE = _{ " " }

query = { SOI ~ expression ~ EOI }
expression = { union }
union = { intersection ~ ("|" ~ intersection)* }
intersection = { primary ~ ("&" ~ primary)* }
primary = _{ function_call | string_literal | symbol | "(" ~ expression ~ ")" }
function_call = { symbol ~ "(" ~ args? ~ ")" }
args = { expression ~ ("," ~ expression)* }
symbol = @{ (ASCII_ALPHANUMERIC | "_" | "@")+ }
string_literal = @{ "\"" ~ ("\\\\" | "\\\"" | (!"\"" ~ ANY))* ~ "\"" }
